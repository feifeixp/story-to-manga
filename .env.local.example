# Google AI API Key
# Get your API key from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Google Analytics Measurement ID (Optional)
# Get this from your Google Analytics 4 property settings
# Format: G-XXXXXXXXXX (e.g., G-1234567890)
# Leave as G-XXXXXXXXXX to disable Google Analytics
# Only real GA IDs will be used - placeholder values are ignored
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-side model overrides. Never prefix credentials with NEXT_PUBLIC_.
# Stable image model replaces the retired image-preview ID.
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_TEXT_MODEL=gemini-2.5-flash
